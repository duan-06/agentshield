// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testResults TestResult[]
  datasetTestResults DatasetTestResult[]

  @@map("users")
}

model RiskCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  createdAt   DateTime @default(now())

  testCases  TestCase[]
  testResults TestResult[]
  datasetTestResults DatasetTestResult[]

  @@map("risk_categories")
}

model TestCase {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  category    RiskCategory @relation(fields: [categoryId], references: [id])
  description String  @db.Text
  examplePrompt String @db.Text
  createdAt   DateTime @default(now())

  testResults TestResult[]

  @@map("test_cases")
}

model TestResult {
  id          Int     @id @default(autoincrement())
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    RiskCategory @relation(fields: [categoryId], references: [id])
  testCaseId  Int?
  testCase    TestCase? @relation(fields: [testCaseId], references: [id])
  input       String  @db.Text
  output      String  @db.Text
  riskLevel   String  // "low", "medium", "high", "critical"
  riskScore   Float   @default(0)
  testType    String  @default("single")  // "single" or "dataset"
  createdAt   DateTime @default(now())

  @@map("test_results")
}

model DatasetTestResult {
  id                    Int     @id @default(autoincrement())
  userId                Int
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId            Int
  category              RiskCategory @relation(fields: [categoryId], references: [id])
  fileName              String
  fileSize              Int
  total                 Int
  blocked               Int
  passed                Int
  blockRate             Float
  avgRiskScore          Float
  riskDistribution      String  @db.Text  // JSON string
  categoryDistribution  String  @db.Text  // JSON string
  riskScoreDistribution String  @db.Text  // JSON string
  details               String  @db.LongText
  createdAt             DateTime @default(now())

  @@map("dataset_test_results")
}
