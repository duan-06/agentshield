# ==================== Llama Shield 环境配置 ====================
# 复制此文件为 .env 并填入实际值

# ==================== 应用配置 ====================
APP_NAME=LlamaShield
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
WORKERS=4
UVICORN_LOG_LEVEL=info

# ==================== 数据库配置 ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llama_shield
POSTGRES_USER=llama_shield
POSTGRES_PASSWORD=change-me-in-production

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== vLLM/Transformers 推理配置 ====================
# 本地模型路径
VLLM_MODEL_PATH=D:/计算机设计大赛/models/qwen/Qwen2___5-7B-Instruct

# GPU 显存利用率（留余量给防护模型）
VLLM_GPU_MEMORY_UTILIZATION=0.75

# 是否优先使用 vLLM（Windows 下建议设为 false）
USE_VLLM=false

# ==================== MiniMax API 推理配置 ====================
# 启用 MiniMax API（优先级高于本地 vLLM/Transformers）
USE_MINIMAX_API=false
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ==================== LlamaFirewall 配置 ====================
LLAMAFIREWALL_MODE=strict
LLAMAFIREWALL_ENABLE_INPUT_SCAN=true
LLAMAFIREWALL_ENABLE_OUTPUT_SCAN=true

# Node 后端调用 /api/v1/chat 时的默认生成上限，避免回答被过早截断
LLAMA_SHIELD_CHAT_MAX_TOKENS=2048
LLAMAFIREWALL_ENABLE_CODE_SCAN=true
LLAMAFIREWALL_ENABLE_ALIGNMENT_CHECK=false
LLAMAFIREWALL_BLOCK_THRESHOLD=0.8
LLAMAFIREWALL_LOG_LEVEL=info

# ==================== 模型下载（必需） ====================
# HuggingFace Token（必需，用于下载 Prompt Guard 模型）
# 获取方式：https://huggingface.co/settings/tokens
HF_TOKEN=

# Together.ai API Key（实验性，用于 Alignment Check）
# 获取方式：https://docs.together.ai/docs/api-keys
TOGETHER_API_KEY=

# ==================== 限流配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ==================== 监控配置 ====================
PROMETHEUS_PORT=9090
METRICS_ENABLED=true
